+config SERIO_LITEX_PS2
+	tristate "LiteX PS/2 keyboard controller"
+	depends on OF && HAS_IOMEM
+	help
+	  Say Y here if your LiteX SoC exposes a PS/2 keyboard controller.
+	  The hardware decodes PS/2 clock/data frames into RX bytes and, when
+	  host-command CSRs are present, provides a serio write path for
+	  libps2/atkbd reset, probe, activation, LED and repeat-rate commands.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called litex_ps2.
+
 config SERIO_AMS_DELTA
 	tristate "Amstrad Delta (E3) mailboard support"
 	depends on MACH_AMS_DELTA
